LOOPFORGE_STORAGE_PATH=.loopforge/loopforge.db

# Provider modes: openai_compatible
LOOPFORGE_LLM_PROVIDER=openai_compatible

# Provider modes: docker_gvisor
LOOPFORGE_SANDBOX_PROVIDER=docker_gvisor

# Works with cloud OpenAI-compatible APIs and local endpoints such as vLLM,
# LM Studio, Ollama OpenAI-compatible gateways, or internal inference servers.
LOOPFORGE_OPENAI_COMPATIBLE_BASE_URL=http://localhost:8000/v1
LOOPFORGE_OPENAI_COMPATIBLE_API_KEY=local-dev-key
LOOPFORGE_OPENAI_COMPATIBLE_MODEL=local-model
LOOPFORGE_OPENAI_COMPATIBLE_TIMEOUT_SECONDS=60

# Docker + gVisor sandbox settings.
LOOPFORGE_DOCKER_GVISOR_RUNTIME=runsc
# The sandbox image MUST carry the approved data-science libraries (pandas, numpy,
# scipy, scikit-learn, statsmodels, xgboost, lightgbm, matplotlib, seaborn). The agent
# cannot pip-install them itself (guardrail #2 — no open pip install), so plain
# python:3.12-slim will fail with "missing package 'pandas'". Build the DS image first:
#   docker build -f docker/sandbox.Dockerfile -t loopforge/sandbox:latest .
LOOPFORGE_DOCKER_SANDBOX_IMAGE=loopforge/sandbox:latest
LOOPFORGE_DOCKER_WORKSPACE_ROOT=/tmp/loopforge-workspaces
LOOPFORGE_DOCKER_NETWORK=none
LOOPFORGE_DOCKER_MEMORY=512m
LOOPFORGE_DOCKER_CPUS=1.0

# Agent engine: native_react (LoopForge's built-in loop, default) or opencode.
# opencode requires the optional dep (`pip install -e .[opencode]`). When selected,
# LoopForge launches `opencode serve` INSIDE the sandbox per run (guardrail #1) and
# connects to it; HOST/PORT below are only used as a fallback if no sandbox is wired.
LOOPFORGE_AGENT_ENGINE=native_react
LOOPFORGE_OPENCODE_HOST=127.0.0.1
LOOPFORGE_OPENCODE_PORT=4096
LOOPFORGE_OPENCODE_PROVIDER_ID=openai
LOOPFORGE_OPENCODE_MODEL_ID=local-model
LOOPFORGE_OPENCODE_MODE=build

# In-sandbox opencode server (used when LOOPFORGE_AGENT_ENGINE=opencode).
# Image must carry the opencode binary + the DS package allowlist — build it from
# docker/opencode-sandbox.Dockerfile.
LOOPFORGE_DOCKER_OPENCODE_IMAGE=loopforge/opencode-sandbox:latest
# The serve container needs a reachable API port, so it cannot use network=none,
# and it must NOT be a --internal network (that blocks the published control port
# AND host access). Two supported setups:
#   Local dev (Docker Desktop):  docker network create loopforge-egress
#     Normal bridge — the container gets general internet (dev only, weaker than
#     guardrail #2). A host-served model at localhost is reached via
#     host.docker.internal (LoopForge rewrites the URL + adds the host-gateway).
#   Prod (Linux host):  egress-allowlist at the firewall (model endpoint +
#     read-only DB only); publish the control port on loopback. Do NOT use the
#     open default bridge in prod.
LOOPFORGE_DOCKER_OPENCODE_NETWORK=loopforge-egress
# gVisor can't use Docker Desktop's internal DNS resolver on a custom bridge, so the
# serve container gets a real nameserver via a bind-mounted resolv.conf. Comma-sep.
# Empty = leave default DNS (prod/Linux); air-gapped/sovereign = your internal resolver.
LOOPFORGE_DOCKER_OPENCODE_DNS=1.1.1.1
LOOPFORGE_OPENCODE_CONTAINER_PORT=4096
LOOPFORGE_OPENCODE_STARTUP_TIMEOUT_SECONDS=30
# opencode's Bun server + in-sandbox DS work needs more RAM than the 512m code-exec
# container; kept separate so raising it doesn't loosen that one.
LOOPFORGE_DOCKER_OPENCODE_MEMORY=2g
# A full agent turn blocks until it finishes (minutes); the client read timeout must
# cover a whole run — the SDK's 60s default kills long runs mid-flight.
LOOPFORGE_OPENCODE_REQUEST_TIMEOUT_SECONDS=900
